# Database Connection
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=nivara

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters
JWT_ALG=HS256
JWT_EXP_HOURS=168

# Application Settings
CORS_ORIGINS=*
PORT=8000

# Field-Level Data Encryption Key (AES-256-GCM)
# Generate a new 64-character hexadecimal key (256-bit) using Python:
# python -c "import secrets; print(secrets.token_hex(32))"
DATA_ENCRYPTION_KEY=replace_with_64_hex_character_256_bit_aes_key

# Safe Haven Provider Configuration
# Options: osc_directory (Verified Government Directory) | openstreetmap (Community Open Data) | demo (Sample Data)
SAFE_HAVEN_PROVIDER=osc_directory
SAFE_HAVEN_CACHE_TTL_SECONDS=900
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

